DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
STAFF_ROLE_ID=your_staff_role_id_here
CORE_ROLE_ID=your_core_role_id_here
SIGNATURE_ROLE_ID=your_signature_role_id_here
SUPPORT_CHANNEL_ID=your_support_channel_id_here
OPTIMIZATION_CHANNEL_ID=your_optimization_channel_id_here
TICKET_CATEGORY_ID=your_ticket_category_id_here
LOG_CHANNEL_ID=your_log_channel_id_here
SUPPORT_LOG_CHANNEL_ID=your_support_log_channel_id_here
OPTIMIZATION_LOG_CHANNEL_ID=your_optimization_log_channel_id_here

# Where tickets.db lives. Set to /app/data in Docker and mount a volume there.
DATA_DIR=./data
# Set to true to force re-posting the panels on next boot.
REPOST_PANELS=false
